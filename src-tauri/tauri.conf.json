{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolKit",
  "version": "0.2.2",
  "identifier": "com.cyd.video-splitter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ToolKit",
        "width": 960,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5OTgzQjc2N0FCQkVBOEUKUldTTzZydDZkanVZdVZSNEJldHBiMWxPMUttMGZPQ1kxVnU3UDRQZ0Z6a21XWkJ2cVZoK01abDkK",
      "endpoints": [
        "https://static-app.97kid.com/app/tool-kit/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
